/target/
/toolchain/
# Screenshot-harness state the app writes beside the exe.
ui.txt
# Local-only test fixtures (third-party brush data, not redistributed —
# the tests skip when they are absent).
crates/brush/tests/data/abr_v6_sample.abr
crates/brush/tests/data/*.sut
# The owner's standalone drawing install (exe + assets copied from release
# builds) — never tracked; running the exe from target/ locks builds.
/play/
# App-beside-exe state.
recent.txt
manganakama.log
prefs.txt
swatches.txt
# The user's registered materials (pattern saves, registered layers) —
# a dev-run writes them beside the repo's assets folder.
/materials-mine/

# standalone vendor-test resolution (MN-PATCH #18); the workspace lock is the real one
vendor/egui_dock/Cargo.lock
